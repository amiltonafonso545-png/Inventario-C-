@model IEnumerable<GestorRHPro.Models.LeaveRequest>
@{ var workspaceLeaves = Model.ToList(); var workspacePending = workspaceLeaves.Count(l => l.Status == GestorRHPro.Models.LeaveStatus.Pending); var workspaceApproved = workspaceLeaves.Count(l => l.Status == GestorRHPro.Models.LeaveStatus.Approved); var workspaceRejected = workspaceLeaves.Count(l => l.Status == GestorRHPro.Models.LeaveStatus.Rejected); }
<section class="workspace-page"><header class="workspace-hero"><div class="workspace-hero-copy"><p class="eyebrow">DISPONIBILIDADE · PLANEAMENTO</p><h1>Férias e ausências</h1><p>Analise pedidos, organize períodos de ausência e acompanhe as decisões da equipa.</p></div><div class="workspace-hero-actions"><a asp-action="Create" class="btn btn-light"><i class="bi bi-plus-lg me-2"></i>Novo pedido</a></div></header>
<div class="workspace-metrics"><div class="workspace-metric"><span class="workspace-metric-icon"><i class="bi bi-calendar2-week"></i></span><span class="workspace-metric-copy"><span>Total de pedidos</span><strong>@workspaceLeaves.Count</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon amber"><i class="bi bi-hourglass-split"></i></span><span class="workspace-metric-copy"><span>Aguardam decisão</span><strong>@workspacePending</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon teal"><i class="bi bi-calendar2-check"></i></span><span class="workspace-metric-copy"><span>Aprovados</span><strong>@workspaceApproved</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon rose"><i class="bi bi-calendar2-x"></i></span><span class="workspace-metric-copy"><span>Recusados</span><strong>@workspaceRejected</strong></span></div></div><section class="workspace-panel"><div class="workspace-panel-head"><div><h2>Pedidos da equipa</h2><p>Os pedidos pendentes aparecem primeiro para facilitar a revisão.</p></div><span class="workspace-status pending">@workspacePending pendentes</span></div>
@{ ViewData["Title"]="Férias"; }
<a asp-action="Create" class="btn btn-primary mb-3">Novo Pedido</a>
<table class="table"><thead><tr><th>Funcionário</th><th>Início</th><th>Fim</th><th>Dias</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach(var l in Model){<tr><td><div class="workspace-person"><span class="workspace-person-mark"><i class="bi bi-person"></i></span><span class="workspace-person-copy"><strong>@l.Employee?.FullName</strong><small>@l.Reason</small></span></div></td><td>@l.StartDate.ToString("dd/MM/yyyy")</td><td>@l.EndDate.ToString("dd/MM/yyyy")</td><td><strong>@l.Days</strong> dias</td><td><span class="workspace-status @(l.Status == GestorRHPro.Models.LeaveStatus.Approved ? "good" : l.Status == GestorRHPro.Models.LeaveStatus.Pending ? "pending" : "bad")">@(l.Status == GestorRHPro.Models.LeaveStatus.Approved ? "Aprovado" : l.Status == GestorRHPro.Models.LeaveStatus.Pending ? "Pendente" : "Recusado")</span></td><td>
@if(l.Status==GestorRHPro.Models.LeaveStatus.Pending){<form asp-action="Approve" method="post" style="display:inline"><input type="hidden" name="id" value="@l.Id"/><button class="btn btn-sm btn-success">Aprovar</button></form>
<form asp-action="Reject" method="post" style="display:inline"><input type="hidden" name="id" value="@l.Id"/><button class="btn btn-sm btn-danger">Rejeitar</button></form>}
</td></tr>}
</tbody></table></section></section>

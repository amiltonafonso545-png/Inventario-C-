@model GestorRHPro.Models.LeaveRequest
@{ ViewData["Title"]="Novo Pedido de Férias"; }
<form asp-action="Create" method="post">
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<div class="mb-3"><label for="EmployeeId">Funcionário</label><select name="employeeId" id="EmployeeId" class="form-select" required><option value="">Selecione um funcionário</option>@foreach (var employee in (IEnumerable<GestorRHPro.Models.Employee>)ViewBag.Employees) { <option value="@employee.Id" selected="@(Model?.EmployeeId == employee.Id)">@employee.FullName</option> }</select><span asp-validation-for="EmployeeId" class="text-danger"></span></div>
<div class="mb-3"><label>Início</label><input asp-for="StartDate" type="date" class="form-control"/></div>
<div class="mb-3"><label>Fim</label><input asp-for="EndDate" type="date" class="form-control"/></div>
<div class="mb-3"><label>Motivo</label><input asp-for="Reason" class="form-control"/></div>
<button class="btn btn-primary">Guardar</button>
</form>

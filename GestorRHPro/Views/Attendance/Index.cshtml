@using GestorRHPro.Models
@inject GestorRHPro.Services.AttendanceSchedule Schedule
@model IEnumerable<GestorRHPro.Models.Attendance>
@{ var lateOnly = ViewData["LateOnly"] is true; var today = Schedule.Today; var workspaceAttendance = Model.ToList(); var workspaceOpen = workspaceAttendance.Count(a => a.CheckIn.HasValue && !a.CheckOut.HasValue); var workspaceLate = workspaceAttendance.Count(a => a.Status == AttendanceStatus.Late); var workspaceToday = workspaceAttendance.Count(a => a.Date.Date == today); }
<section class="workspace-page"><header class="workspace-hero"><div class="workspace-hero-copy"><p class="eyebrow">TEMPO · PRESENÇAS</p><h1>Assiduidade</h1><p>Acompanhe entradas, saídas e ocorrências de presença da equipa.</p></div><div class="workspace-hero-actions"><span class="workspace-status good"><i class="bi bi-calendar-event"></i> @today.ToString("dd/MM/yyyy")</span></div></header>
<div class="workspace-metrics"><div class="workspace-metric"><span class="workspace-metric-icon"><i class="bi bi-clock-history"></i></span><span class="workspace-metric-copy"><span>Registos apresentados</span><strong>@workspaceAttendance.Count</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon teal"><i class="bi bi-calendar-check"></i></span><span class="workspace-metric-copy"><span>Registos de hoje</span><strong>@workspaceToday</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon amber"><i class="bi bi-hourglass-split"></i></span><span class="workspace-metric-copy"><span>Entradas em aberto</span><strong>@workspaceOpen</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon rose"><i class="bi bi-alarm"></i></span><span class="workspace-metric-copy"><span>Atrasos</span><strong>@workspaceLate</strong></span></div></div><section class="workspace-panel"><div class="workspace-panel-head"><div><h2>Linha de assiduidade</h2><p>Entrada prevista às @Schedule.StartTime.ToString("HH:mm"), com @Schedule.GraceMinutes min de tolerância.</p></div><span class="workspace-status">@workspaceAttendance.Count registos</span></div>
@{ ViewData["Title"]="Assiduidade"; }
<nav class="attendance-filters" aria-label="Filtrar registos de assiduidade">
    <a asp-action="Index" class="attendance-filter" aria-current="@(!lateOnly ? "page" : null)">
        <i class="bi bi-list-ul" aria-hidden="true"></i> Todos
    </a>
    <a asp-action="Index" asp-route-lateOnly="true" class="attendance-filter" aria-current="@(lateOnly ? "page" : null)">
        <i class="bi bi-alarm" aria-hidden="true"></i> Só atrasos
    </a>
</nav>
<form asp-action="Export" method="post" class="attendance-export" aria-label="Descarregar registos de assiduidade">
    <div class="attendance-export-scope">
        <label for="exportEmployeeId" class="form-label">Descarregar registos de</label>
        <select id="exportEmployeeId" name="employeeId" class="form-select form-select-sm"
                asp-items="@(ViewData["ExportEmployees"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)">
            <option value="">Toda a equipa</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary btn-sm">
        <i class="bi bi-download" aria-hidden="true"></i> Descarregar CSV
    </button>
</form>
@if (workspaceAttendance.Count == 0)
{
    <p>@(lateOnly ? "Ainda não há atrasos registados." : "Ainda não há registos de assiduidade.")</p>
}
<div class="table-responsive"><table class="table"><thead><tr><th>Funcionário</th><th>Data</th><th>Entrada</th><th>Saída</th><th>Estado</th></tr></thead><tbody>
@foreach(var a in workspaceAttendance){<tr><td><div class="workspace-person"><span class="workspace-person-mark"><i class="bi bi-person"></i></span><span class="workspace-person-copy"><strong>@a.Employee?.FullName</strong><small>@a.Employee?.InternalNumber</small></span></div></td><td>@a.Date.ToString("dd/MM/yyyy")</td><td>@(a.CheckIn is DateTime checkIn ? Schedule.LocalTime(checkIn).ToString("HH:mm") : "—")</td><td>@(a.CheckOut is DateTime checkOut ? Schedule.LocalTime(checkOut).ToString("HH:mm") : "—")</td><td><span class="workspace-status @(a.Status == AttendanceStatus.Present ? "good" : a.Status == AttendanceStatus.Late ? "pending" : "bad")">@(a.Status == AttendanceStatus.Present ? "Presente" : a.Status == AttendanceStatus.Late ? "Atrasado" : a.Status == AttendanceStatus.OnLeave ? "De licença" : "Ausente")</span></td></tr>}
</tbody></table></div></section></section>

@model IEnumerable<GestorRHPro.Models.Attendance>
@{ var workspaceAttendance = Model.ToList(); var workspaceOpen = workspaceAttendance.Count(a => a.CheckIn.HasValue && !a.CheckOut.HasValue); var workspaceLate = workspaceAttendance.Count(a => a.Status == GestorRHPro.Models.AttendanceStatus.Late); var workspaceToday = workspaceAttendance.Count(a => a.Date.Date == DateTime.Today); }
<section class="workspace-page"><header class="workspace-hero"><div class="workspace-hero-copy"><p class="eyebrow">TEMPO · PRESENÇAS</p><h1>Assiduidade</h1><p>Acompanhe entradas, saídas e ocorrências de presença da equipa.</p></div><div class="workspace-hero-actions"><span class="workspace-status good"><i class="bi bi-calendar-event"></i> @DateTime.Today.ToString("dd/MM/yyyy")</span></div></header>
<div class="workspace-metrics"><div class="workspace-metric"><span class="workspace-metric-icon"><i class="bi bi-clock-history"></i></span><span class="workspace-metric-copy"><span>Registos apresentados</span><strong>@workspaceAttendance.Count</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon teal"><i class="bi bi-calendar-check"></i></span><span class="workspace-metric-copy"><span>Registos de hoje</span><strong>@workspaceToday</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon amber"><i class="bi bi-hourglass-split"></i></span><span class="workspace-metric-copy"><span>Entradas em aberto</span><strong>@workspaceOpen</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon rose"><i class="bi bi-alarm"></i></span><span class="workspace-metric-copy"><span>Atrasos</span><strong>@workspaceLate</strong></span></div></div><section class="workspace-panel"><div class="workspace-panel-head"><div><h2>Linha de assiduidade</h2><p>Registos mais recentes da organização.</p></div><span class="workspace-status">@workspaceAttendance.Count registos</span></div>
@{ ViewData["Title"]="Assiduidade"; }
<table class="table"><thead><tr><th>Funcionário</th><th>Data</th><th>Entrada</th><th>Saída</th><th>Estado</th></tr></thead><tbody>
@foreach(var a in Model){<tr><td><div class="workspace-person"><span class="workspace-person-mark"><i class="bi bi-person"></i></span><span class="workspace-person-copy"><strong>@a.Employee?.FullName</strong><small>@a.Employee?.InternalNumber</small></span></div></td><td>@a.Date.ToString("dd/MM/yyyy")</td><td>@(a.CheckIn?.ToLocalTime().ToString("HH:mm") ?? "—")</td><td>@(a.CheckOut?.ToLocalTime().ToString("HH:mm") ?? "—")</td><td><span class="workspace-status @(a.Status == GestorRHPro.Models.AttendanceStatus.Present ? "good" : a.Status == GestorRHPro.Models.AttendanceStatus.Late ? "pending" : "bad")">@(a.Status == GestorRHPro.Models.AttendanceStatus.Present ? "Presente" : a.Status == GestorRHPro.Models.AttendanceStatus.Late ? "Atrasado" : a.Status == GestorRHPro.Models.AttendanceStatus.OnLeave ? "De licença" : "Ausente")</span></td></tr>}
</tbody></table></section></section>

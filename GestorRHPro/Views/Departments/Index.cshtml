@model IEnumerable<GestorRHPro.Models.Department>
@{ var workspaceDepartments = Model.ToList(); var workspaceStaff = workspaceDepartments.Sum(d => d.Employees.Count); var workspaceFilled = workspaceDepartments.Count(d => d.Employees.Count > 0); }
<section class="workspace-page"><header class="workspace-hero"><div class="workspace-hero-copy"><p class="eyebrow">ESTRUTURA ORGANIZACIONAL</p><h1>Departamentos</h1><p>Veja como as pessoas estão distribuídas e mantenha a estrutura da organização atualizada.</p></div><div class="workspace-hero-actions"><a asp-action="Create" class="btn btn-light"><i class="bi bi-plus-lg me-2"></i>Novo departamento</a></div></header>
<div class="workspace-metrics"><div class="workspace-metric"><span class="workspace-metric-icon"><i class="bi bi-diagram-3"></i></span><span class="workspace-metric-copy"><span>Departamentos</span><strong>@workspaceDepartments.Count</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon teal"><i class="bi bi-people"></i></span><span class="workspace-metric-copy"><span>Pessoas distribuídas</span><strong>@workspaceStaff</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon amber"><i class="bi bi-building-check"></i></span><span class="workspace-metric-copy"><span>Com equipa</span><strong>@workspaceFilled</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon rose"><i class="bi bi-building-exclamation"></i></span><span class="workspace-metric-copy"><span>Por preencher</span><strong>@(workspaceDepartments.Count - workspaceFilled)</strong></span></div></div><section class="workspace-panel"><div class="workspace-panel-head"><div><h2>Mapa de departamentos</h2><p>Dimensão atual de cada equipa.</p></div></div>
@{ ViewData["Title"]="Departamentos"; }
<a asp-action="Create" class="btn btn-primary mb-3">Novo Departamento</a>
<table class="table"><thead><tr><th>Nome</th><th>Funcionários</th><th></th></tr></thead><tbody>
@foreach(var d in Model){<tr><td>@d.Name</td><td>@d.Employees.Count</td><td><a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-warning">Editar</a> <a asp-action="Delete" asp-route-id="@d.Id" class="btn btn-sm btn-danger">Eliminar</a></td></tr>}
</tbody></table></section></section>

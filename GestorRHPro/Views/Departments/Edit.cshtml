@model GestorRHPro.Models.Department
@{ ViewData["Title"]="Editar"; }
<form asp-action="Edit" method="post">
<input type="hidden" asp-for="Id"/>
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="Name">Nome</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Description">Descrição</label><input asp-for="Description" class="form-control"/><span asp-validation-for="Description" class="text-danger"></span></div>
<button class="btn btn-primary" type="submit">Guardar</button>
<a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

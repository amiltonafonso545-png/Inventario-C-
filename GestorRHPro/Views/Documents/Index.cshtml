@model IEnumerable<GestorRHPro.Models.EmployeeDocument>
@{ var workspaceDocuments = Model.ToList(); var workspaceExpired = workspaceDocuments.Count(d => d.ExpiryDate.HasValue && d.ExpiryDate.Value.Date < DateTime.Today); var workspaceExpiring = workspaceDocuments.Count(d => d.ExpiryDate.HasValue && d.ExpiryDate.Value.Date >= DateTime.Today && d.ExpiryDate.Value.Date <= DateTime.Today.AddDays(30)); }
<section class="workspace-page"><header class="workspace-hero"><div class="workspace-hero-copy"><p class="eyebrow">ARQUIVO · PARTILHA SEGURA</p><h1>Documentos</h1><p>Consulte os ficheiros da equipa e acompanhe documentos com validade.</p></div><div class="workspace-hero-actions"><a asp-action="Create" class="btn btn-light"><i class="bi bi-cloud-arrow-up me-2"></i>Novo documento</a></div></header>
<div class="workspace-metrics"><div class="workspace-metric"><span class="workspace-metric-icon"><i class="bi bi-folder2-open"></i></span><span class="workspace-metric-copy"><span>Ficheiros partilhados</span><strong>@workspaceDocuments.Count</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon teal"><i class="bi bi-shield-check"></i></span><span class="workspace-metric-copy"><span>Dentro da validade</span><strong>@(workspaceDocuments.Count - workspaceExpired)</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon amber"><i class="bi bi-calendar2-event"></i></span><span class="workspace-metric-copy"><span>Expiram em 30 dias</span><strong>@workspaceExpiring</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon rose"><i class="bi bi-calendar2-x"></i></span><span class="workspace-metric-copy"><span>Expirados</span><strong>@workspaceExpired</strong></span></div></div><section class="workspace-panel"><div class="workspace-panel-head"><div><h2>Arquivo de documentos</h2><p>Ficheiros associados ao perfil de cada funcionário.</p></div></div>
@{ ViewData["Title"]="Documentos"; }
<a asp-action="Create" class="btn btn-primary mb-3">Novo Documento</a>
@if (TempData["DocumentNotice"] is string notice)
{
    <div class="alert alert-info" role="status">@notice</div>
}
<table class="table"><thead><tr><th>Funcionário</th><th>Ficheiro</th><th>Categoria</th><th>Validade</th></tr></thead><tbody>
@foreach(var d in Model){var expired = d.ExpiryDate.HasValue && d.ExpiryDate.Value.Date < DateTime.Today; var expiring = d.ExpiryDate.HasValue && d.ExpiryDate.Value.Date >= DateTime.Today && d.ExpiryDate.Value.Date <= DateTime.Today.AddDays(30); <tr><td><div class="workspace-person"><span class="workspace-person-mark"><i class="bi bi-person"></i></span><span class="workspace-person-copy"><strong>@d.Employee?.FullName</strong><small>@d.Employee?.InternalNumber</small></span></div></td><td><a asp-action="Download" asp-route-id="@d.Id" class="workspace-file-link"><i class="bi bi-file-earmark-text me-1"></i>@d.FileName</a><small class="workspace-secondary d-block mt-1">Adicionado @d.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy")</small></td><td><span class="workspace-status">@d.Category</span></td><td>@if (d.ExpiryDate.HasValue) { <span class="workspace-status @(expired ? "bad" : expiring ? "pending" : "good")">@d.ExpiryDate.Value.ToString("dd/MM/yyyy")</span> } else { <span class="workspace-secondary">Sem validade</span> }</td></tr>}
</tbody></table></section></section>

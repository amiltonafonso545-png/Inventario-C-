@model GestorRHPro.ViewModels.EmployeeLeavesPageViewModel
@using GestorRHPro.Models
@using System.Globalization
@{ ViewData["Title"] = "Férias"; var pt = CultureInfo.GetCultureInfo("pt-PT"); }

<div class="page-heading mb-4"><div><p class="text-muted mb-1">Área pessoal</p><h1 class="h3 mb-0">Os meus pedidos de férias</h1></div></div>
@if (TempData["PortalMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }
@if (TempData["PortalError"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
@if (!Model.HasEmployeeRecord)
{
    <div class="alert alert-info">A sua conta ainda não está associada a um funcionário. Contacte os Recursos Humanos.</div>
}
else
{
    <section class="surface-card mb-4">
        <div class="card-heading mb-3"><div><h2>Enviar pedido</h2><p>O pedido fica pendente até ser analisado pelos Recursos Humanos.</p></div></div>
        <form asp-action="RequestLeave" method="post" class="row g-3">
            <div class="col-md-4"><label for="StartDate" class="form-label">Data de início</label><input type="date" id="StartDate" name="StartDate" class="form-control" required /></div>
            <div class="col-md-4"><label for="EndDate" class="form-label">Data de fim</label><input type="date" id="EndDate" name="EndDate" class="form-control" required /></div>
            <div class="col-md-4"><label for="Reason" class="form-label">Motivo (opcional)</label><input type="text" id="Reason" name="Reason" maxlength="500" class="form-control" /></div>
            <div class="col-12"><button type="submit" class="btn btn-primary">Enviar pedido</button></div>
        </form>
    </section>
    <section class="surface-card">
        <div class="card-heading mb-3"><div><h2>Histórico de pedidos</h2></div></div>
        @if (Model.Leaves.Count == 0) { <p class="text-muted mb-0">Ainda não tem pedidos de férias.</p> }
        else
        {
            <div class="table-responsive"><table class="table align-middle mb-0">
                <thead><tr><th>Início</th><th>Fim</th><th>Dias</th><th>Motivo</th><th>Estado</th></tr></thead>
                <tbody>@foreach (var leave in Model.Leaves) { <tr><td>@leave.StartDate.ToString("d", pt)</td><td>@leave.EndDate.ToString("d", pt)</td><td>@leave.Days</td><td>@(string.IsNullOrWhiteSpace(leave.Reason) ? "—" : leave.Reason)</td><td>@(leave.Status switch { LeaveStatus.Pending => "Pendente", LeaveStatus.Approved => "Aprovado", _ => "Rejeitado" })</td></tr> }</tbody>
            </table></div>
        }
    </section>
}

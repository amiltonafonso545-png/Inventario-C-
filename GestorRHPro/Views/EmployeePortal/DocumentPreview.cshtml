@model GestorRHPro.ViewModels.EmployeeDocumentPreviewViewModel
@{
    ViewData["Title"] = Model.FileName;
}

<div class="page-heading mb-4">
    <div>
        <p class="text-muted mb-1">Pré-visualização do documento</p>
        <h1 class="h3 mb-0">@Model.FileName</h1>
    </div>
    <a asp-action="Documents" class="btn btn-outline-secondary">Voltar aos documentos</a>
</div>

<article class="surface-card p-4" aria-label="Conteúdo do documento">
    @if (Model.Paragraphs.Count == 0)
    {
        <p class="text-muted mb-0">Este documento não contém texto que possa ser apresentado na pré-visualização.</p>
    }
    else
    {
        @foreach (var paragraph in Model.Paragraphs)
        {
            <p style="white-space: pre-wrap">@paragraph</p>
        }
    }
</article>

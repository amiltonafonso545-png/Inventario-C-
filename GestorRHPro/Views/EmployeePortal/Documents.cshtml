@model GestorRHPro.ViewModels.EmployeeDocumentsPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Os meus documentos";
    var pt = CultureInfo.GetCultureInfo("pt-PT");
}

<div class="page-heading mb-4">
    <div><p class="text-muted mb-1">Área pessoal</p><h1 class="h3 mb-0">Os meus documentos</h1></div>
</div>

@if (!Model.HasEmployeeRecord)
{
    <div class="alert alert-info" role="status">A sua conta ainda não está associada a um registo de funcionário. Contacte o administrador ou os Recursos Humanos.</div>
}
else if (Model.Documents.Count == 0)
{
    <div class="surface-card p-4"><p class="text-muted mb-0">Ainda não tem documentos partilhados consigo.</p></div>
}
else
{
    <div class="surface-card p-3 p-md-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Documento</th><th>Categoria</th><th>Enviado em</th><th>Validade</th><th></th></tr></thead>
                <tbody>
                @foreach (var document in Model.Documents)
                {
                    <tr>
                        <td>@document.FileName</td>
                        <td>@document.Category</td>
                        <td>@document.UploadedAt.ToLocalTime().ToString("d", pt)</td>
                        <td>@(document.ExpiryDate?.ToString("d", pt) ?? "—")</td>
                        <td><a asp-action="DownloadDocument" asp-route-id="@document.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-download me-1"></i>Transferir</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

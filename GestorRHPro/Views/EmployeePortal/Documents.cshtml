@model GestorRHPro.ViewModels.EmployeeDocumentsPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Os meus documentos";
    var pt = CultureInfo.GetCultureInfo("pt-PT");
}
@{ var expiredDocuments = Model.Documents.Count(document => document.ExpiryDate.HasValue && document.ExpiryDate.Value.Date < DateTime.Today); var expiringDocuments = Model.Documents.Count(document => document.ExpiryDate.HasValue && document.ExpiryDate.Value.Date >= DateTime.Today && document.ExpiryDate.Value.Date <= DateTime.Today.AddDays(30)); }
<section class="workspace-page employee-portal-summary"><header class="workspace-hero"><div class="workspace-hero-copy"><p class="eyebrow">ARQUIVO · ÁREA PESSOAL</p><h1>Os meus documentos</h1><p>Aceda aos ficheiros que os Recursos Humanos partilharam consigo.</p></div><div class="workspace-hero-actions"><span class="workspace-status good"><i class="bi bi-shield-check"></i> Acesso privado</span></div></header><div class="workspace-metrics"><div class="workspace-metric"><span class="workspace-metric-icon"><i class="bi bi-folder2-open"></i></span><span class="workspace-metric-copy"><span>Documentos disponíveis</span><strong>@Model.Documents.Count</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon teal"><i class="bi bi-shield-check"></i></span><span class="workspace-metric-copy"><span>Válidos ou sem validade</span><strong>@(Model.Documents.Count - expiredDocuments)</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon amber"><i class="bi bi-calendar2-event"></i></span><span class="workspace-metric-copy"><span>Expiram em 30 dias</span><strong>@expiringDocuments</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon rose"><i class="bi bi-calendar2-x"></i></span><span class="workspace-metric-copy"><span>Expirados</span><strong>@expiredDocuments</strong></span></div></div></section>

<div class="page-heading mb-4">
    <div><p class="text-muted mb-1">Área pessoal</p><h1 class="h3 mb-0">Os meus documentos</h1></div>
</div>

@if (!Model.HasEmployeeRecord)
{
    <div class="alert alert-info" role="status">A sua conta ainda não está associada a um registo de funcionário. Contacte o administrador ou os Recursos Humanos.</div>
}
else if (Model.Documents.Count == 0)
{
    <div class="surface-card p-4"><p class="text-muted mb-0">Ainda não tem documentos partilhados consigo.</p></div>
}
else
{
    <div class="surface-card p-3 p-md-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Documento</th><th>Categoria</th><th>Enviado em</th><th>Validade</th><th></th></tr></thead>
                <tbody>
                @foreach (var document in Model.Documents)
                {
                    <tr>
                        <td><i class="bi bi-file-earmark-text me-2 text-primary"></i><a asp-action="ViewDocument" asp-route-id="@document.Id" target="_blank" rel="noopener" class="workspace-file-link">@document.FileName</a></td>
                        <td>@document.Category</td>
                        <td>@document.UploadedAt.ToLocalTime().ToString("d", pt)</td>
                        <td>@(document.ExpiryDate?.ToString("d", pt) ?? "—")</td>
                        <td class="text-nowrap">
                            <a asp-action="ViewDocument" asp-route-id="@document.Id" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>Abrir</a>
                            <a asp-action="DownloadDocument" asp-route-id="@document.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download me-1"></i>Transferir</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@model IEnumerable<GestorRHPro.Models.Position>
@{ var workspacePositions = Model.ToList(); var workspacePlaced = workspacePositions.Sum(p => p.Employees.Count); var workspaceTeams = workspacePositions.Where(p => p.DepartmentId.HasValue).Select(p => p.DepartmentId).Distinct().Count(); }
<section class="workspace-page"><header class="workspace-hero"><div class="workspace-hero-copy"><p class="eyebrow">FUNÇÕES · CARREIRAS</p><h1>Cargos</h1><p>Organize as funções da empresa, associe-as a departamentos e acompanhe a ocupação.</p></div><div class="workspace-hero-actions"><a asp-action="Create" class="btn btn-light"><i class="bi bi-plus-lg me-2"></i>Novo cargo</a></div></header>
<div class="workspace-metrics"><div class="workspace-metric"><span class="workspace-metric-icon"><i class="bi bi-briefcase"></i></span><span class="workspace-metric-copy"><span>Cargos definidos</span><strong>@workspacePositions.Count</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon teal"><i class="bi bi-person-workspace"></i></span><span class="workspace-metric-copy"><span>Funcionários atribuídos</span><strong>@workspacePlaced</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon amber"><i class="bi bi-diagram-3"></i></span><span class="workspace-metric-copy"><span>Departamentos envolvidos</span><strong>@workspaceTeams</strong></span></div><div class="workspace-metric"><span class="workspace-metric-icon rose"><i class="bi bi-person-plus"></i></span><span class="workspace-metric-copy"><span>Cargos sem ocupação</span><strong>@workspacePositions.Count(p => p.Employees.Count == 0)</strong></span></div></div><section class="workspace-panel"><div class="workspace-panel-head"><div><h2>Catálogo de funções</h2><p>Cargos disponíveis e respetiva distribuição organizacional.</p></div></div>
@{ ViewData["Title"]="Cargos"; }
<a asp-action="Create" class="btn btn-primary mb-3">Novo Cargo</a>
<table class="table"><thead><tr><th>Nome</th><th>Departamento</th><th></th></tr></thead><tbody>
@foreach(var p in Model){<tr><td>@p.Name</td><td>@p.Department?.Name</td><td><a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Editar</a> <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">Eliminar</a></td></tr>}
</tbody></table></section></section>

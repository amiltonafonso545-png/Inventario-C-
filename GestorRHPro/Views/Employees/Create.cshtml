@model GestorRHPro.Models.Employee
@{ ViewData["Title"]="Novo Funcionário"; }
<form asp-action="Create" method="post">
<div class="mb-3"><label>Nome</label><input asp-for="FullName" class="form-control"/></div>
<div class="mb-3"><label>Email</label><input asp-for="Email" class="form-control"/></div>
<div class="mb-3"><label>Telefone</label><input asp-for="Phone" class="form-control"/></div>
<div class="mb-3"><label>Departamento</label><select asp-for="DepartmentId" asp-items="@(new SelectList(ViewBag.Departments,"Id","Name"))" class="form-select"></select></div>
<div class="mb-3"><label>Cargo</label><select asp-for="PositionId" asp-items="@(new SelectList(ViewBag.Positions,"Id","Name"))" class="form-select"></select></div>
<div class="mb-3"><label>Data Admissão</label><input asp-for="HireDate" type="date" class="form-control"/></div>
<button class="btn btn-primary">Guardar</button>
</form>

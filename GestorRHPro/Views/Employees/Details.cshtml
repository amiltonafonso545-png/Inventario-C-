@model GestorRHPro.Models.Employee
@{ ViewData["Title"]="Detalhes"; }
<dl class="row">
<dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@Model.FullName</dd>
<dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
<dt class="col-sm-3">Departamento</dt><dd class="col-sm-9">@Model.Department?.Name</dd>
<dt class="col-sm-3">Cargo</dt><dd class="col-sm-9">@Model.Position?.Name</dd>
<dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@Model.Status</dd>
</dl>

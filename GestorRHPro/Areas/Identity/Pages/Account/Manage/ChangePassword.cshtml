@page
@model GestorRHPro.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{
    ViewData["Title"] = "Alterar palavra-passe";
}

<div class="password-page">
    <nav class="password-breadcrumb" aria-label="Navegação estrutural">
        <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i><span>Painel</span></a>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <a asp-controller="Profile" asp-action="Index">O meu perfil</a>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span>Alterar palavra-passe</span>
    </nav>

    <header class="password-page-heading">
        <span class="password-heading-icon"><i class="bi bi-shield-lock"></i></span>
        <div>
            <p class="password-eyebrow">SEGURANÇA DA CONTA</p>
            <h1>Alterar palavra-passe</h1>
            <p>Atualize a palavra-passe usada para iniciar sessão.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="password-success" role="status"><i class="bi bi-check-circle"></i>@Model.StatusMessage</div>
    }

    <div class="password-layout">
        <section class="password-card" aria-labelledby="password-form-title">
            <div class="password-card-heading">
                <span class="password-card-icon"><i class="bi bi-key"></i></span>
                <div>
                    <h2 id="password-form-title">Credenciais</h2>
                    <p>Preencha os três campos para guardar a alteração.</p>
                </div>
            </div>
            <form method="post" class="password-form">
                <div asp-validation-summary="ModelOnly" class="password-validation" role="alert"></div>
                <div class="password-field">
                    <label asp-for="Input.CurrentPassword"></label>
                    <div class="password-input-wrap">
                        <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                        <button type="button" class="password-visibility-toggle" data-password-toggle aria-label="Mostrar palavra-passe atual">Mostrar</button>
                    </div>
                    <span asp-validation-for="Input.CurrentPassword" class="password-field-error"></span>
                </div>
                <div class="password-field">
                    <label asp-for="Input.NewPassword"></label>
                    <div class="password-input-wrap">
                        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-describedby="password-requirements password-checklist" data-new-password />
                        <button type="button" class="password-visibility-toggle" data-password-toggle aria-label="Mostrar nova palavra-passe">Mostrar</button>
                    </div>
                    <span asp-validation-for="Input.NewPassword" class="password-field-error"></span>
                    <ul id="password-checklist" class="password-checklist" aria-live="polite">
                        <li data-rule="length"><i class="bi bi-circle"></i><span>Pelo menos 12 caracteres</span></li>
                        <li data-rule="upper"><i class="bi bi-circle"></i><span>Uma letra maiúscula</span></li>
                        <li data-rule="lower"><i class="bi bi-circle"></i><span>Uma letra minúscula</span></li>
                        <li data-rule="digit"><i class="bi bi-circle"></i><span>Um número</span></li>
                        <li data-rule="symbol"><i class="bi bi-circle"></i><span>Um símbolo</span></li>
                    </ul>
                    <small id="password-requirements" class="password-field-hint">Mínimo de 12 caracteres, com maiúscula, minúscula, número e símbolo.</small>
                </div>
                <div class="password-field">
                    <label asp-for="Input.ConfirmPassword"></label>
                    <div class="password-input-wrap">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <button type="button" class="password-visibility-toggle" data-password-toggle aria-label="Mostrar confirmação da palavra-passe">Mostrar</button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="password-field-error"></span>
                    <small class="password-match-message" data-password-match aria-live="polite"></small>
                </div>
                <div class="password-form-actions">
                    <button type="submit" class="password-save-button"><i class="bi bi-check2"></i>Guardar nova palavra-passe</button>
                    <a asp-controller="Profile" asp-action="Index" class="password-cancel-link">Cancelar</a>
                </div>
            </form>
        </section>

        <aside class="password-help-card">
            <span class="password-help-icon"><i class="bi bi-shield-check"></i></span>
            <h2>Uma palavra-passe mais segura</h2>
            <p>Escolha uma palavra-passe única que não use noutros serviços. Não a partilhe com outras pessoas.</p>
            <ul>
                <li><i class="bi bi-check2"></i>Pelo menos 12 caracteres</li>
                <li><i class="bi bi-check2"></i>Maiúsculas e minúsculas</li>
                <li><i class="bi bi-check2"></i>Número e símbolo</li>
            </ul>
            <div class="password-help-foot"><i class="bi bi-lock"></i> A alteração aplica-se ao próximo início de sessão.</div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const newPassword = document.querySelector('[data-new-password]');
        const confirmPassword = document.getElementById('Input_ConfirmPassword');
        const matchMessage = document.querySelector('[data-password-match]');
        const passwordRules = {
            length: value => value.length >= 12,
            upper: value => /[A-Z]/.test(value),
            lower: value => /[a-z]/.test(value),
            digit: value => /[0-9]/.test(value),
            symbol: value => /[^a-zA-Z0-9]/.test(value)
        };

        function updatePasswordMatch() {
            if (!newPassword || !confirmPassword || !matchMessage) return;
            const hasConfirmation = confirmPassword.value.length > 0;
            const matches = hasConfirmation && newPassword.value === confirmPassword.value;
            matchMessage.textContent = !hasConfirmation ? '' : (matches ? 'As palavras-passe coincidem.' : 'As palavras-passe ainda não coincidem.');
            matchMessage.classList.toggle('is-valid', matches);
            matchMessage.classList.toggle('is-invalid', hasConfirmation && !matches);
        }

        function updatePasswordChecklist() {
            if (!newPassword) return;
            const value = newPassword.value;
            document.querySelectorAll('[data-rule]').forEach(item => {
                const valid = value.length > 0 && passwordRules[item.dataset.rule](value);
                item.classList.toggle('is-valid', valid);
                item.querySelector('i').className = valid ? 'bi bi-check-circle-fill' : 'bi bi-circle';
            });
            updatePasswordMatch();
        }

        newPassword?.addEventListener('input', updatePasswordChecklist);
        confirmPassword?.addEventListener('input', updatePasswordMatch);
        updatePasswordChecklist();

        document.querySelectorAll('[data-password-toggle]').forEach(button => {
            button.addEventListener('click', () => {
                const input = button.closest('.password-input-wrap').querySelector('input');
                const reveal = input.type === 'password';
                input.type = reveal ? 'text' : 'password';
                button.textContent = reveal ? 'Ocultar' : 'Mostrar';
                button.setAttribute('aria-pressed', reveal.toString());
            });
        });
    </script>
}
